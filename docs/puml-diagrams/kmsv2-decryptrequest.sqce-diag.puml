@startuml "Kubernetes KMS v2 Decrypt Request & Response"

'=============================================================================='
'== PlantUML Appearance parameters ============================================'
'=============================================================================='
skinparam shadowing false
'skinparam backgroundColor transparent

' enable arrows on same level
'!pragma teoz true

skinparam legend {
  FontSize 13
  FontName DejaVu Sans Mono
  BorderColor black
  BackgroundColor white
}

skinparam sequence {
ArrowColor Black
ActorBorderColor Black
LifeLineBorderColor Black
LifeLineBackgroundColor #A9DCDF

ParticipantBorderColor MidnightBlue
ParticipantBackgroundColor #326CE5
ParticipantFontName Impact
ParticipantFontSize 17
ParticipantFontColor white

ActorBackgroundColor MidnightBlue
ActorFontColor MidnightBlue
ActorFontSize 17
ActorFontName Aapex
}

skinparam ArrowFontName DejaVu Sans Mono


'=============================================================================='
'== Title ====================================================================='
'=============================================================================='
title
    KMS v2 Decrypt Request & Response
    Kubernetes KMS API v2 - k8s.io/kms/apis/v2 & KMS Plugin for PKCS #11
end title

skinparam HeaderFontSize 14
header <font color=black>Kubernetes KMS v2 & k8s-kms-plugin Figure %page% of %lastpage%</font>
footer © 2026 Eclipse Foundation — Eclipse KeySealer Project

' Legend
legend top left
    Legend
    CKA_ID   (Byte array) PKCS #11 Key identifier for public/private key pairs
    DEK      Data Encryption Key (derived by kube-apiserver from the 32-byte DEK seed)
    JWE      JSON Web Encryption
    KEK      Key Encryption Key
    KEM      Key Encapsulation Mechanism
    KMS      Key Management System
    HSM      Hardware Security Module
    ML-KEM   Module-Lattice-Based KEM (FIPS 203, post-quantum)
    TPM      Trusted Platform Module

    DecryptRequest.Ciphertext holds a JWE for the aes-gcm / aes-cbc / rsa-oaep families,
    and a 60-byte binary envelope (nonce | AES-GCM(DEK seed) | tag) for ml-kem.
    Annotations are returned verbatim from the matching EncryptResponse: they always carry
    algorithm-family.k8s-kms-plugin.keysealer.eclipse.org, plus, for ml-kem only,
    kem-ciphertext.k8s-kms-plugin.keysealer.eclipse.org holding the FIPS 203 ciphertext c.
    KeyId is the hex-encoded CKA_ID of the KEK that produced the ciphertext.

    PKCS #11 v3.2: https://docs.oasis-open.org/pkcs11/pkcs11-base/v3.2/pkcs11-base-v3.2.html
    FIPS 203 (ML-KEM): https://doi.org/10.6028/NIST.FIPS.203
    KMS v2: - https://kubernetes.io/docs/tasks/administer-cluster/kms-provider/
            - https://github.com/kubernetes/enhancements/tree/master/keps/sig-auth/3299-kms-v2-improvements
end legend

'=============================================================================='
'== Sequence diagram begins ==================================================='
'=============================================================================='

    actor "k8s admin" as k8sa
    actor "kms admin" as kmsa

    box "kubernetes" #AliceBlue
        participant "k8s apiserver" as k8sapisrv
        participant "etcd" as etcd
    end box


    box "kms plugin & PKCS #11 TPM/HSM" #fff
        participant "k8s-kms-plugin (server)" as kmsplg
        participant "pkcs11-device" as p11
    end box

    group KMS v2 & Kubernetes node restart
        note over k8sa, etcd : After a kubernetes reboot, k8s sends both a first StatusRequest to know which key id is active. \nk8s generates a new DEK seed and a corresponding EncryptionRequest in case the key id changed. \nk8s sends as many DecryptRequests as their are encrypted DEK seeds in ETCD; preferably it should \nnot be more than 2 different DEKs at the same time. This happens during a key rotation.

        k8sa -> k8sapisrv : Reboot a kubernetes \nserver node

        note over kmsa, kmsplg : Case: KEK Key Id from the k8s-kms-plugin is the same than before k8s reboot (same KEK)

            group KMS v2 first StatusRequest
                k8sapisrv -> kmsplg : send StatusRequest
                kmsplg -> p11 : validate remote KEK, e.g. \n get CKA_ID from TPM/HSM
                p11 -> kmsplg : return KEK status, e.g. CKA_ID
                kmsplg -> k8sapisrv : return StatusResponse \n {Version:"v2", Healthz: "ok", \n KeyId:<hex CKA_ID of the KEK, the same than before k8s reboot>}
            end

            k8sapisrv -> etcd : get encrypted resource
            etcd -> k8sapisrv : return encrypted resource

        loop For active KEK and all the old KEK Keys (As many different Key Ids) that still exist in the ETCD DB, do a DecryptRequest.
            group DecryptRequest
                k8sapisrv -> kmsplg : send DecryptRequest \n {Ciphertext:<JWE or ML-KEM envelope as []byte>, \n KeyId:<hex CKA_ID of the KEK that encrypted it>, \n Uid:<string>, Annotations:<map[string][]byte>, returned verbatim}

                alt --algorithm-family = aes-gcm | aes-cbc | rsa-oaep (JWE input)
                    kmsplg -> p11 : Decrypt(Ciphertext) \n unwrap the DEK seed with the remote KEK \n (rsa-oaep: CKM_RSA_PKCS_OAEP unwraps the CEK inside the HSM)
                    kmsplg <- p11 : return the decrypted DEK seed

                else --algorithm-family = ml-kem (post-quantum, binary envelope)
                    kmsplg -> kmsplg : read the KEM ciphertext c from the \n kem-ciphertext annotation, resolve the ML-KEM \n key pair from DecryptRequest.KeyId
                    kmsplg -> p11 : ML-KEM.Decaps(dk, c)
                    kmsplg <- p11 : return the same shared secret K (32 B)
                    kmsplg -> kmsplg : re-derive the AES key from K with KMAC, \n then AES-GCM-open the 60-byte envelope \n -> the DEK seed
                end

                kmsplg -> k8sapisrv : return DecryptResponse \n {Plaintext:<32-byte DEK seed as []byte>}
            end

            note over kmsplg, p11 : Routing is driven by the plugin's own ~--algorithm-family, never by the algorithm-family \nannotation, so an altered annotation cannot change how a ciphertext is interpreted. \nThe KEK is resolved from DecryptRequest.KeyId; under //serve rotation// the plugin also \nfalls back to the old PKCS #11 context, so objects written under the previous KEK \nstill decrypt.

            k8sapisrv -> k8sapisrv : cache decrypted DEK seed
            k8sapisrv -> k8sapisrv : generate DEK using decrypted DEK seed from cache
            k8sapisrv -> k8sapisrv : decrypt resource with DEK
        end
    end
@enduml