@startuml "Kubernetes KMS v2 & KMS Plugin"

'=============================================================================='
'== PlantUML Appearance parameters ============================================'
'=============================================================================='
skinparam shadowing false
'skinparam backgroundColor transparent

' enable arrows on same level
'!pragma teoz true

skinparam legend {
  FontSize 13
  FontName DejaVu Sans Mono
  BorderColor black
  BackgroundColor white
}

skinparam sequence {
ArrowColor Black
ActorBorderColor Black
LifeLineBorderColor Black
LifeLineBackgroundColor #A9DCDF

ParticipantBorderColor MidnightBlue
ParticipantBackgroundColor #326CE5
ParticipantFontName Impact
ParticipantFontSize 17
ParticipantFontColor white

ActorBackgroundColor MidnightBlue
ActorFontColor MidnightBlue
ActorFontSize 17
ActorFontName Aapex
}

skinparam ArrowFontName DejaVu Sans Mono


'=============================================================================='
'== Title ====================================================================='
'=============================================================================='
title
    Kubernetes KMS API v2 - k8s.io/kms/apis/v2 & KMS Plugin for PKCS #11
end title

skinparam HeaderFontSize 14
header <font color=black>kubernetes KMS v2 & KMS- Figure %page% of %lastpage%</font>
footer © 2025 Thales Group for Thales Open Source

' Legend
legend top left
    Legend
    CKA_ID (Byte array) PKCS #11 Key identifier for public/private key pairs
    DEK    Data Encryption Key
    KEK    Key Encryption Key
    KMS    Key Management System
    HSM    Hardware Security Module
    TPM    Trusted Platform Module
    
    PKCS #11 v3.0: https://docs.oasis-open.org/pkcs11/pkcs11-base/v3.0/pkcs11-base-v3.0.html
    KMS v2: - https://kubernetes.io/docs/tasks/administer-cluster/kms-provider/
            - https://github.com/kubernetes/enhancements/tree/master/keps/sig-auth/3299-kms-v2-improvements
end legend

'=============================================================================='
'== Sequence diagram begins ==================================================='
'=============================================================================='

    actor "k8s admin" as k8sa
    actor "kms admin" as kmsa

    box "kubernetes" #AliceBlue
        participant "k8s apiserver" as k8sapisrv
        participant "etcd" as etcd
    end box


    box "kms plugin & PKCS #11 TPM/HSM" #fff
        participant "k8s-kms-plugin (server)" as kmsplg
        participant "pkcs11-device" as p11
    end box

    group KMS v2 first startup & Status heartbeet & rotation
        alt Generate DEK seed at k8s startup

        kmsa -> kmsplg : run k8s-kms-plugin serve with a KEK stored on the TPM
        k8sa -> k8sapisrv : deploy/install/start \na kubernetes cluster
        k8sapisrv -> k8sapisrv : generate DEK seed (32 random bytes)\nat startup and cache it ; indefinite \nretention until kube-apiserver restart \nor KEK rotation

          group KMS v2 Encrypts DEK Seed
          k8sapisrv -> kmsplg : send EncryptRequest \n {Plaintext:<DEK seed as []byte>, Uid:<string>}
          kmsplg -> p11 : Encrypt(Plaintext) \n encrypt DEK seed with remote KEK
          p11 -> kmsplg : return encrypted DEK seed & KEK ID, \n e.g. CKA_ID
          kmsplg -> k8sapisrv : return EncryptResponse \n {Ciphertext:<encrypted DEK seed as []byte>,\n KeyId: <remote KEK ID as string>, \n Annotations: <map[string][]byte>}
          end
    
        k8sapisrv -> etcd : TODO verify if the encrypted DEK seed is stored
        end

        loop every minute when plugin is healthy or every 10 seconds when the plugin is not healthy
        k8sapisrv -> kmsplg : send StatusRequest
        kmsplg -> p11 : validate remote KEK, e.g. \n get CKA_ID from TPM/HSM
        p11 -> kmsplg : return KEK status, e.g. CKA_ID
        kmsplg -> k8sapisrv : return StatusResponse \n {Version:"v2", Healthz: "ok", \n KeyId:<remote KEK ID string>}
        end

        alt remote KEK rotation detected from last StatusResponse (KeyId changed), rotate DEK seed
        kmsa -> kmsplg : run k8s-kms-plugin with a new KEK and keep old KEK available to \ndecrypt previously encrypted data and reencrypt with new KEK
        k8sapisrv -> k8sapisrv : generate a new DEK seed (32 random bytes)\nat startup and cache it ; indefinite \nretention until kube-apiserver restart \nor KEK rotation

          group KMS v2 encrypt new DEK Seed
          k8sapisrv -> kmsplg : send EncryptRequest \n {Plaintext:<new DEK seed as []byte>, Uid:<string>}
          kmsplg -> p11 : Encrypt(Plaintext) \n encrypt new DEK seed with new remote KEK
          p11 -> kmsplg : return new encrypted DEK seed & new KEK ID \n must not re-use old key_ids
          kmsplg -> k8sapisrv : return EncryptResponse \n {Ciphertext:<new encrypted DEK seed as []byte>,\n KeyId: <new remote KEK ID as string>, \n Annotations:... }
          end
          
        k8sapisrv -> etcd : TODO verify if the new encrypted DEK seed is stored
        note over k8sapisrv, etcd : data encrypted with the old KEK should be marked stale
        end
    end

    group KMS v2 Encrypt new resource

        note over k8sapisrv, etcd : generate a DEK seed at startup & cache it, or do a DecryptRequest to decrypt DEK Seed & then cache it

        k8sa -> k8sapisrv : create/update resource that's \n to be encrypted
        k8sapisrv -> k8sapisrv : generate a single use DEK using \ndecrypted DEK seed from cache
        k8sapisrv -> k8sapisrv : encrypt resource with DEK
        k8sapisrv -> etcd : store encrypted object
    end

    group KMS v2 Decrypt a resource
        k8sa -> k8sapisrv : get/list resource that's encrypted
        k8sapisrv -> etcd : get encrypted resource
        etcd -> k8sapisrv : return encrypted resource

        alt when encrypted DEK seed is not in cache ; KMS plugin is only called when cache is empty
        k8sapisrv -> kmsplg : send DecryptRequest \n {Ciphertext:<[]byte>, KeyId:<string>, \n Uid:<string>, Annotations: <map[string][]byte>}
        kmsplg -> p11 : Decrypt(Ciphertext) \n decrypt DEK seed with remote KEK
        kmsplg <- p11 : return decrypted DEK seed
        kmsplg -> k8sapisrv : return DecryptResponse \n {Plaintext:<decrypted DEK seed []byte>}
        k8sapisrv -> k8sapisrv : cache decrypted DEK seed
        end

        k8sapisrv -> k8sapisrv : generate DEK using decrypted DEK seed from cache
        k8sapisrv -> k8sapisrv : decrypt resource with DEK

        k8sapisrv -> k8sa : return decrypted resource
    end

@enduml